                confirmText="Exit"
                cancelText="Cancel"
                onClose={handleModalResponse}
              />
            )}

            {user.uniqueIdentity && !partner_disconnected ? (
              <div className="chat-input-container">
                {/* {user.uniqueIdentity && !partner_disconnected ? ( */}
                <div className="chat-input-inner">
                  <div className="input-wrapper">
                    <textarea
                      className="text-box"
                      rows={1}
                      placeholder="Type your message..."
                      value={input}
                      onChange={handleUserInput}
                      maxLength={
                        msgTOBot
                          ? MAX_MESSAGE_TO_BOT_LENGTH
                          : MAX_MESSAGE_TO_AGENT_LENGTH
                      }
                      onKeyDown={(e) => {
                        if (e.key === "Enter" && !e.shiftKey) {
                          e.preventDefault();
                          if (!isSending && input.trim()) {
                            handleSubmit();
                          }
                        }
                      }}
                    />
                    <span
                      className={`char-count ${
                        input.length >=
                        (msgTOBot
                          ? MAX_MESSAGE_TO_BOT_LENGTH - 10
                          : MAX_MESSAGE_TO_AGENT_LENGTH - 10)
                          ? "char-warning"
                          : ""
                      }`}
                    >
                      {input.length}/
                      {msgTOBot
                        ? MAX_MESSAGE_TO_BOT_LENGTH
                        : MAX_MESSAGE_TO_AGENT_LENGTH}
                    </span>
                    <button
                      type="submit"
                      className={`send-button ${isSending ? "thinking" : ""}`}
                      onClick={handleSubmit}
                      disabled={isSending}
                    >
                      {isSending ? (
                        <FaSpinner
                          className="spin"
                          size={20}
                          style={{ color: "#fff" }}
                        />
                      ) : (
                        // <FaPaperPlane size={20} />
                        <img src={sendSvg} alt="Send" />
                      )}
                    </button>
                  </div>
                </div>
                {/* ) : null} */}

                {/* {!user.uniqueIdentity && !partner_disconnected ? (
                <div className="chat-input-inner">
                  <button
                    type="submit"
                    className="send-button"
                    onClick={startChat}
                    style={{ width: "100%", justifyContent: "center" }}
                  >
                    <i className="bi bi-send-fill send_icon"></i>
                    <i>Start Chat</i>
                  </button>
                </div>
              ) : null} */}
              </div>
            ) : null}

            {/* {partner_disconnected ? (
              <div className="chat-input-inner">
                <button
                  type="submit"
                  className="send-button"
                  onClick={ReconnectToAgent}
                  style={{ width: "100%", justifyContent: "center" }}
                >
                  <i className="bi bi-send-fill send_icon"></i>
                  <i>Reconnect Now</i>
                </button>
              </div>
            ) : null} */}
          </div>
        </div>
      </div>
      {/* </Draggable> */}
    </>
  );
}

export default Chatbot;
