    // const ws = new WebSocket(`wss://tfmapi.techfeatures.ai/ws/chat?userId=${userIdFromDb}&role=User`);
    const ws = new WebSocket(
      `${process.env.REACT_APP_URL_FOR_WEBSOCKET}?userId=${userIdFromDb}&userEmail=${UserEmailfromlocalstorage}&role=User&userName=${username}`
      //  `wss://localhost:7226/ws/chat?userId=${UserId}&role=User&userName= ${username}`
    );

    //  const ws = new WebSocket(`wss://localhost:7226/ws/chat?userId=${userIdFromDb}&role=User&userName= ${username}`);
    ws.onopen = () => {
      // 👉 Ask server to connect me with agentId
      ws.send(
        JSON.stringify({
          type: "invite",
          to: ConnectedAgent,
        })
      );
    };

    ws.onmessage = (event) => {
      const data = JSON.parse(event.data);

      if (data.type === "invite_sent") {
        setMessages((prev) => [
          ...prev,
          {
            type: "Agent",
            text: "Invite sent, waiting for agent to accept...",
            time: new Date(),
          },
        ]);
        /*   setpaired(false); */
      } else if (data.type === "error") {
        let id = parseInt(localStorage.getItem("userIdFromDb"));
        setUserIdFromDb(id);
        setMessages((prev) => [
          ...prev,
          {
            status: "connectButton",
            type: "Agent",
            text: "Your previous agent is offline. you can connect with new agent.",
            time: new Date(),
          },
        ]);
        let connectionid = localStorage.getItem("connectionId");
        try {
          const msgAgentToUser = {
            connectionId: connectionid,
            userId: localStorage.getItem("userIdFromDb"),
            msg: " Your previous agent is offline. you can connect with new agent..",
            sender: ChatRoles.Agent,
            receiver: ChatRoles.User,
          };
          postUserAgentMessage(msgAgentToUser);
        } catch (err) {}
        ws.close();
        setPartnerDisconnected(false);
        let newUser;
        if (email && name) {
          newUser = { name, email, uniqueIdentity: email };
          localStorage.setItem("guestUserId", email);
        } else if (userRandomId) {
          newUser = { name: null, email: null, uniqueIdentity: userRandomId };
        } else {
          const guestId = crypto.randomUUID();
          localStorage.setItem("guestUserId", guestId);
          newUser = { name: null, email: null, uniqueIdentity: guestId };
        }

        setUser(newUser);
        setconnectToAgentBtn(true);
      } else if (data.type === "paired") {
        console.log("wsref", wsRef.current);

        toast.success("Reconnected to agent successfully.");
        setpaired(true);
        setmsgToBot(false);
        localStorage.removeItem("disconnect_time");
        localStorage.setItem("partner_disconnected", JSON.stringify(false));
        setPartnerDisconnected(false);
        setUser((prev) => ({
          ...prev,
          uniqueIdentity: localStorage.getItem("guestUserId"),
        }));

        setMessages((prev) => [
          ...prev,
          {
            type: "Agent",
            text: "Hi! Lets Continue our discussion..",
            time: new Date(),
          },
        ]);
        enableDisconnectListener();
        startTimer();
        let connectionid = localStorage.getItem("connectionId");
        try {
          const msgAgentToUser = {
            connectionId: connectionid,
            userId: localStorage.getItem("userIdFromDb"),
            msg: "Hi! Lets Continue our discussion..",
            sender: ChatRoles.Agent,
            receiver: ChatRoles.User,
          };
          postUserAgentMessage(msgAgentToUser);
        } catch (err) {}
      } else if (data.type === "agent-typing") {
        // Show "Thinking..." message before calling API
        setIsAgentTyping(true);
      } else if (data.type === "agent-stop-typing") {
        // Remove "Thinking..." message
        setIsAgentTyping(false);
      } else if (data.type === "message") {
        setIsAgentTyping(false);
        setalreadySeen(false);
        setMessages((prev) => [
          ...prev,
          { type: "Agent", text: data.content, time: new Date() },
        ]);
        var connectionid = localStorage.getItem("connectionId");
        try {
          const msgAgentToUser = {
            connectionId: connectionid,
            userId: localStorage.getItem("userIdFromDb"),
            msg: data.content,
            sender: ChatRoles.Agent,
            receiver: ChatRoles.User,
          };
          postUserAgentMessage(msgAgentToUser);
        } catch (err) {}
      } else if (data.type === "message_sent") {
        setMessages((prev) =>
          prev.filter((msg) => {
            // 1️⃣ If it's a simple string message (bot/user text)
            if (
              typeof msg.messageType === "string" &&
              msg.type === "user" &&
              msg.messageType.includes("Seen")
            ) {
              msg.messageType = "Seen";
              // return false; // remove it
            } else {
              msg.messageType = data.content;
            }
            return true;
          })
        );
      } else if (data.type === "message_delivered") {
