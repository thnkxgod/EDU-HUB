  //listener for local storage changes
  function useLocalStorageListener(callback) {
    useEffect(() => {
      const handleStorageChange = (event) => {
        if (event.storageArea === localStorage) {
          callback(event);
        }
      };

      const handleManualLogout = () => {
        callback({ key: "manualLogout", type: "manual" });
      };
      const handleManualLogin = () => {
        callback({ key: "manualLogin", type: "manual" });
      };

      // Listen to storage changes across tabs
      window.addEventListener("storage", handleStorageChange);
      // Listen to custom logout events in this tab
      window.addEventListener("manualLogout", handleManualLogout);
      window.addEventListener("manualLogin", handleManualLogin);

      return () => {
        window.removeEventListener("storage", handleStorageChange);
        window.removeEventListener("manualLogout", handleManualLogout);
        window.removeEventListener("manualLogin", handleManualLogin);
      };
    }, [callback]);
  }

